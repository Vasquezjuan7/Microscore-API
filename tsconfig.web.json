{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "moduleDetection": "legacy",
    "rootDir": "./web",
    "outDir": "./public",
    "strict": true,
    "strictNullChecks": false,
    "removeComments": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["web/**/*.ts"]
}
